<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Simi 💖</title>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  font-family:Arial,sans-serif;
  background:linear-gradient(135deg,#ffd6e7,#e8d8ff);
  overflow:hidden;
  color:#5b3150;
}

.card{
  width:90%;
  max-width:420px;
  padding:32px 24px;
  text-align:center;
  background:rgba(255,255,255,.9);
  border-radius:28px;
  box-shadow:0 15px 45px rgba(100,50,100,.2);
}

.lock{
  font-size:60px;
}

h1{
  font-size:29px;
  margin:12px 0;
}

p{
  font-size:16px;
}

input{
  width:100%;
  padding:14px;
  border:2px solid #e8a9c8;
  border-radius:14px;
  outline:none;
  font-size:17px;
  text-align:center;
}

button{
  width:100%;
  padding:14px;
  margin-top:14px;
  border:0;
  border-radius:14px;
  background:#d85b91;
  color:white;
  font-size:17px;
  font-weight:bold;
}

#error{
  color:#c43d68;
  min-height:22px;
}

#surprise{
  display:none;
}

.big{
  font-size:60px;
}

.message{
  line-height:1.7;
  font-size:17px;
}

.heart{
  position:fixed;
  top:-40px;
  font-size:25px;
  animation:fall 6s linear infinite;
}

@keyframes fall{
  from{
    transform:translateY(-10vh) rotate(0deg);
  }
  to{
    transform:translateY(110vh) rotate(360deg);
  }
}
</style>
</head>

<body>

<div class="card" id="lock">

  <div class="lock">🔐</div>

  <h1>My Favorite Word</h1>

  <p>
    Ek special word hai jo is surprise ko unlock karega 💗
  </p>

  <input
    id="password"
    type="password"
    placeholder="Enter password"
  >

  <button onclick="unlock()">
    Unlock ✨
  </button>

  <p id="error"></p>

</div>


<div class="card" id="surprise">

  <div class="big">🎂💖</div>

  <h1>Happy Birthday, Simi! 🌸</h1>

  <p class="message">
    Simi, tum bahut special ho ✨
    <br><br>

    Tumhari smile hamesha aise hi bright rahe,
    aur tumhari life khushiyon se bhari rahe. 💕
    <br><br>

    <b>Have the most beautiful birthday! 🎀</b>
  </p>

  <div style="font-size:30px">
    🌷 🦋 🎁 ✨ 🌷
  </div>

</div>


<script>

function unlock(){

  let password =
    document.getElementById("password").value
    .trim()
    .toLowerCase();

  if(password === "simi"){

    document.getElementById("lock").style.display = "none";

    document.getElementById("surprise").style.display = "block";

    for(let i=0;i<20;i++){

      let heart = document.createElement("div");

      heart.className = "heart";

      heart.innerHTML =
        ["💗","💕","💖","🌸","✨"][i%5];

      heart.style.left =
        Math.random()*100 + "vw";

      heart.style.animationDelay =
        Math.random()*5 + "s";

      document.body.appendChild(heart);
    }

  }else{

    document.getElementById("error").innerHTML =
      "Wrong password 😜 Try again!";

  }

}

document
.getElementById("password")
.addEventListener("keydown",function(e){

  if(e.key === "Enter"){
    unlock();
  }

});

</script>

</body>
</html>
